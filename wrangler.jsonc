/**
 * Bridgewarden Worker configuration.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bridgewarden",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bridgewarden-db",
      "database_id": "f67dc6ca-07ea-4612-8e1c-e1a6c0c3ee15",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV_SESSIONS",
      "id": "34324f5089ba45c8978c38c03920ae52",
    },
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER_IP",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
    {
      "name": "RATE_LIMITER_IDENTITY",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
  ],
  // R2 binding is intentionally absent: R2 is not enabled on this account yet.
  // Add `r2_buckets` with binding "R2" in phase 2, when attachments are implemented.
}
