{
  "name": "bridgewarden",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "NODE_ENV=development react-router dev",
    "build": "react-router build && node scripts/strip-build-secrets.ts && node scripts/generate-service-worker.ts && node scripts/check-sonner-csp-hash.ts && node scripts/check-bundle-budget.ts",
    "preview": "pnpm build && node scripts/preview.ts",
    "deploy": "node scripts/check-remote-migrations.ts && pnpm build && wrangler deploy",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply bridgewarden-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bridgewarden-db --remote",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 .wrangler/state/v3/kv && pnpm db:migrate:local",
    "postinstall": "wrangler types",
    "test:e2e": "node scripts/test-e2e.ts",
    "db:migrate:e2e": "wrangler d1 migrations apply bridgewarden-db --local --persist-to .wrangler/e2e"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.4",
    "isbot": "^5.1.36",
    "lucide-react": "^1.68.0",
    "qrcode": "1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
