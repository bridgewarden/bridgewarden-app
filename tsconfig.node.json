{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "e2e/**/*",
    "vitest.sequencer.ts",
    "app/lib/i18n/en.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": ["node", "vite/client"],
    "lib": ["ES2022", "DOM"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}
